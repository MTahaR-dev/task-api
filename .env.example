# Copy this file to .env and adjust as needed:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# .env is gitignored because it is where real secrets go. This file is committed so
# that anyone cloning the repo knows exactly which variables the app expects.

# Which storage backend to use: sqlite | postgres
TASK_REPOSITORY=postgres

# --- Postgres credentials (used by docker-compose to create the database) ---
POSTGRES_USER=taskuser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskdb

# --- Connection string used by the app ---
# Running the app on your machine against the container:  host = localhost
# Running the app INSIDE docker compose:                  host = db  (the service name)
# docker-compose.yml overrides this for the app container, so leave it as localhost here.
DATABASE_URL=postgresql://taskuser:change-me@localhost:5432/taskdb
